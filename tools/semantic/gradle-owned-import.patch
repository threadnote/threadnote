+    private OwnedBuildControl(Map<String, String> values) throws Exception {
+        attempt = hex(values.get("attemptNonce"));
+        launchNonce = hex(values.get("launchNonce"));
+        uid = values.get("uid");
+        if (!uid.matches("[a-fA-F0-9-]{36}")) throw denied();
+        contextHash = hex(values.get("contextHash"));
+        events = absolute(values.get("events"));
+        if (!Files.isDirectory(events, LinkOption.NOFOLLOW_LINKS)) throw denied();
+        long remaining = Long.parseLong(values.get("expiresAt")) - System.currentTimeMillis();
+        if (remaining <= 0 || remaining > 300000) throw denied();
+    }
+
+    public static OwnedBuildControl capture(File project, File userHome, File baseDir, File javaHome, boolean embedded) {
+        try {
+            if (embedded) throw denied();
+            String uri = System.getProperty("threadnote.ownedImport.controlUri");
+            String expected = hex(System.getProperty("threadnote.ownedImport.controlSha256"));
+            if (uri == null) throw denied();
+            Path input = absolute(new File(new URI(uri)).getPath());
+            if (!Files.isRegularFile(input, LinkOption.NOFOLLOW_LINKS) || Files.size(input) > 16384) throw denied();
+            byte[] bytes = Files.readAllBytes(input);
+            if (bytes.length > 16384 || !hash(bytes).equals(expected)) throw denied();
+            String text = StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+                .onUnmappableCharacter(CodingErrorAction.REPORT).decode(ByteBuffer.wrap(bytes)).toString();
+            Map<String, String> values = new HashMap<String, String>();
+            for (String line : text.split("\\n", -1)) {
+                if (line.isEmpty()) continue;
+                int split = line.indexOf('=');
+                if (split <= 0 || !line.substring(split + 1).matches("[A-Za-z0-9_-]+")) throw denied();
+                String value = new String(Base64.getUrlDecoder().decode(line.substring(split + 1)), StandardCharsets.UTF_8);
+                if (value.length() > 4096 || value.indexOf('\0') >= 0 || value.indexOf('\n') >= 0 || values.put(line.substring(0, split), value) != null) throw denied();
+            }
+            List<String> keys = Arrays.asList("version", "attemptNonce", "launchNonce", "uid", "contextHash", "project", "userHome", "baseDir", "javaHome", "gradleHome", "events", "expiresAt");
+            if (!values.keySet().equals(new java.util.HashSet<String>(keys)) || !"1".equals(values.get("version"))) throw denied();
+            same(project, values.get("project"));
+            same(userHome, values.get("userHome"));
+            same(baseDir, values.get("baseDir"));
+            same(javaHome, values.get("javaHome"));
+            File ownJar = new File(OwnedBuildControl.class.getProtectionDomain().getCodeSource().getLocation().toURI()).getCanonicalFile();
+            if (!"gradle-client-services-9.8.2.jar".equals(ownJar.getName())) throw denied();
+            same(ownJar.getParentFile().getParentFile(), values.get("gradleHome"));
+            return new OwnedBuildControl(values);
+        } catch (Exception failure) {
+            throw denied();
+        }
+    }
+
+    public static void ready(String expectedUid, DaemonContext actual) {
+        try {
+            String nonce = hex(System.getProperty("threadnote.ownedImport.launchNonce"));
+            if (!expectedUid.equals(actual.getUid())) throw denied();
+            // Original foreground stdout is the only ready transport. No token/registry/PID becomes authority.
+            String image = contextImage(actual);
+            String frame = "THREADNOTE_OWNED_READY_V1 " + nonce + " " + actual.getUid() + " " + hash(image.getBytes(StandardCharsets.UTF_8)) + " " + Base64.getUrlEncoder().withoutPadding().encodeToString(image.getBytes(StandardCharsets.UTF_8));
+            if (frame.length() > 12288) throw denied();
+            System.out.println(frame);
+            System.out.flush();
+            if (System.out.checkError()) throw denied();
+        } catch (Exception failure) { throw denied(); }
+    }
+
+    private static String context(DaemonContext value) throws Exception {
+        return hash(contextImage(value).getBytes(StandardCharsets.UTF_8));
+    }
+
+    private static String contextImage(DaemonContext value) throws Exception {
+        List<String> options = new ArrayList<String>(value.getDaemonOpts());
+        Collections.sort(options);
+        List<String> fields = new ArrayList<String>(Arrays.asList(value.getUid(), value.getJavaHome().getCanonicalPath(),
+            value.getJavaVersion().toString(), value.getJavaVendor(), value.getDaemonRegistryDir().getCanonicalPath(),
+            String.valueOf(value.getPid()), String.valueOf(value.getIdleTimeout()), value.getPriority().name(),
+            String.valueOf(value.shouldApplyInstrumentationAgent()), value.getNativeServicesMode().name()));
+        fields.addAll(options);
+        StringBuilder canonical = new StringBuilder();
+        for (String field : fields) {
+            if (field.length() > 4096 || canonical.length() + field.length() + 6 > 8192) throw denied();
+            canonical.append(field.length()).append(':').append(field);
+        }
+        return canonical.toString();
+    }
+
+    public DaemonConnector wrap(final DaemonConnector delegate, final ExplainingSpec<DaemonContext> normal) {
+        final OwnedBuildControl control = this;
+        return new DaemonConnector() {
+            private ExplainingSpec<DaemonContext> constrained(final ExplainingSpec<DaemonContext> requested) {
+                return new ExplainingSpec<DaemonContext>() {
+                    public boolean isSatisfiedBy(DaemonContext candidate) { return whyUnsatisfied(candidate) == null; }
+                    public String whyUnsatisfied(DaemonContext candidate) {
+                        try {
+                            if (!uid.equals(candidate.getUid()) || !contextHash.equals(context(candidate))) return "Owned foreground context differs.";
+                        } catch (Exception failure) { return "Owned foreground context unavailable."; }
+                        String mismatch = normal.whyUnsatisfied(candidate);
+                        return mismatch == null ? requested.whyUnsatisfied(candidate) : mismatch;
+                    }
+                };
+            }
+            private DaemonClientConnection accepted(DaemonClientConnection connection) {
+                if (connection == null) throw denied();
+                if (!uid.equals(connection.getDaemon().getUid())) {
+                    connection.stop();
+                    throw denied();
+                }
+                if (connected.compareAndSet(false, true)) control.record("connected");
+                return connection;
+            }
+            // connect() on the ordinary connector can start a daemon internally: never delegate it.
+            public DaemonClientConnection connect(ExplainingSpec<DaemonContext> requested) {
+                return accepted(delegate.maybeConnect(constrained(requested)));
+            }
+            public DaemonClientConnection maybeConnect(ExplainingSpec<DaemonContext> requested) {
+                return accepted(delegate.maybeConnect(constrained(requested)));
+            }
+            // Direct address retry cannot establish complete compatibility; refuse before delegation.
+            public DaemonClientConnection maybeConnect(DaemonConnectDetails details) { throw denied(); }
+            public DaemonClientConnection startDaemon(ExplainingSpec<DaemonContext> requested) { throw denied(); }
+            public DaemonClientConnection startSingleUseDaemon() { throw denied(); }
+            public void markDaemonAsUnavailable(DaemonConnectDetails details) {
+                if (!uid.equals(details.getUid())) throw denied();
+                delegate.markDaemonAsUnavailable(details);
+            }
+        };
+    }
+
+    public void succeeded() {
+        if (!connected.get() || !finished.compareAndSet(false, true)) throw denied();
+        record("success");
+    }
+    public void failed(Throwable original) {
+        if (finished.compareAndSet(false, true)) {
+            try { record("failure"); } catch (RuntimeException observationFailure) { original.addSuppressed(observationFailure); }
+        }
+    }
+    private void record(String state) {
+        try {
+            byte[] frame = ("THREADNOTE_OWNED_OPERATION_V1 " + attempt + " " + launchNonce + " " + operation + " " + uid + " " + contextHash + " " + state + "\n").getBytes(StandardCharsets.US_ASCII);
+            if (frame.length > 1024) throw denied();
+            Files.write(events.resolve(operation + "." + state), frame, StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE);
+        } catch (IOException failure) { throw denied(); }
+    }
+    private static Path absolute(String value) throws IOException {
+        if (value == null) throw denied();
+        File file = new File(value);
+        if (!file.isAbsolute() || !file.getCanonicalPath().equals(file.getPath())) throw denied();
+        return file.toPath();
+    }
+    private static void same(File actual, String expected) throws IOException {
+        if (actual == null || !actual.getCanonicalFile().toPath().equals(absolute(expected))) throw denied();
+    }
+    private static String hex(String value) {
+        if (value == null || !value.matches("[a-f0-9]{64}")) throw denied();
+        return value;
+    }
+    private static String hash(byte[] bytes) throws Exception {
+        byte[] digest = MessageDigest.getInstance("SHA-256").digest(bytes);
+        StringBuilder result = new StringBuilder();
+        for (byte value : digest) result.append(String.format(java.util.Locale.ROOT, "%02x", value & 255));
+        return result.toString();
+    }
+    private static IllegalStateException denied() { return new IllegalStateException("Owned Gradle import control refused."); }

diff --git a/tsc/cmd/tsc/lsp_external_process_test.go b/tsc/cmd/tsc/lsp_external_process_test.go
new file mode 100644
--- /dev/null
+++ b/tsc/cmd/tsc/lsp_external_process_test.go
@@ -0,0 +1,54 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/microsoft/TypeScript/tsc/internal/lsp"
+	"github.com/microsoft/TypeScript/tsc/internal/tspath"
+)
+
+func TestLSPHostDeniesExternalProcesses(t *testing.T) {
+	// Exercise the same constructor as runLSP, not just a denial helper. An
+	// incoming host callback must not survive selection by the production host.
+	opts := &lsp.ServerOptions{
+		Cwd: tspath.RootedDirectoryPathFromAbsolute("/project"),
+		Err: io.Discard,
+		NpmInstall: func(context.Context, string, []string) ([]byte, error) {
+			t.Fatal("incoming npm callback was invoked")
+			return nil, nil
+		},
+		Spawn: func([]string, string, io.Writer) (io.ReadWriteCloser, error) {
+			t.Fatal("incoming spawn callback was invoked")
+			return nil, nil
+		},
+	}
+	server := newNoExternalProcessLSPServer(opts)
+	for _, args := range [][]string{nil, {"install", "--ignore-scripts", "types-registry@latest"}, {"install", "@types/example"}} {
+		result, err := server.NpmInstall(context.Background(), opts.Cwd, args)
+		if result != nil || !errors.Is(err, errExternalProcessDisabled) {
+			t.Fatalf("npm host did not refuse: result=%v, error=%v", result, err)
+		}
+	}
+	assertExternalSpawnDenied(t, opts.Spawn)
+}
+
+func TestAPISystemDeniesExternalProcesses(t *testing.T) {
+	// runAPI supplies the actual OS system as ContentMapperSpawner. Denial is
+	// unconditional, including when RunExternalCode is explicitly requested.
+	assertExternalSpawnDenied(t, (&osSys{}).Spawn)
+}
+
+func assertExternalSpawnDenied(t *testing.T, spawn func([]string, string, io.Writer) (io.ReadWriteCloser, error)) {
+	t.Helper()
+	for _, command := range [][]string{nil, {}, {""}, {"npm", "install", "example"}, {"node", "mapper.js"}} {
+		var stderr bytes.Buffer
+		process, err := spawn(command, "/project", &stderr)
+		if process != nil || !errors.Is(err, errExternalProcessDisabled) || stderr.Len() != 0 {
+			t.Fatalf("spawn host did not refuse: process=%v, error=%v, stderr=%q", process, err, stderr.String())
+		}
+	}
+}

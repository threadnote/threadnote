+
+// newNoExternalProcessLSPServer installs the host policy before the server copies
+// its callbacks. ATA and content mappers cannot launch external programs, even
+// when a client requests external-code support.
+func newNoExternalProcessLSPServer(opts *lsp.ServerOptions) *lsp.Server {
+	opts.NpmInstall = func(context.Context, string, []string) ([]byte, error) {
+		return nil, errExternalProcessDisabled
+	}
+	opts.Spawn = denyExternalProcess
+	return lsp.NewServer(opts)
 }
 

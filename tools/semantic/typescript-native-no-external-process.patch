 func (s *osSys) Spawn(command []string, dir string, stderr io.Writer) (io.ReadWriteCloser, error) {
-	return spawnProcess(command, dir, stderr)
+	return denyExternalProcess(command, dir, stderr)
+}
+
+var errExternalProcessDisabled = errors.New("external process execution is disabled in this TypeScript build")
+
+// denyExternalProcess is shared by the LSP host and the API/CLI system. Refusal
+// does not inspect arguments, resolve executables, or touch process state.
+func denyExternalProcess([]string, string, io.Writer) (io.ReadWriteCloser, error) {
+	return nil, errExternalProcessDisabled
 }
 

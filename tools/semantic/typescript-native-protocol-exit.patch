+func TestServerProtocolExitPreservesConcurrentWriteFailure(t *testing.T) {
+	for _, failure := range []error{io.ErrClosedPipe, context.Canceled} {
+		t.Run(failure.Error(), func(t *testing.T) {
+			t.Parallel()
+			writeStarted, exitRead, releaseInput := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			t.Cleanup(func() { close(releaseInput) })
+			shutdown := protocolExitMessage(t, protocolShutdown)
+			exit := protocolExitMessage(t, protocolExit)
+			index := 0
+			reader := protocolExitReaderFunc(func() (*lsproto.Message, error) {
+				index++
+				switch index {
+				case 1:
+					return shutdown, nil
+				case 2:
+					select {
+					case <-writeStarted:
+						close(exitRead)
+						return exit, nil
+					case <-releaseInput:
+						return nil, io.EOF
+					}
+				default:
+					return nil, io.EOF
+				}
+			})
+			var server *Server
+			writer := protocolExitWriterFunc(func(*lsproto.Message) error {
+				close(writeStarted)
+				<-exitRead
+				// Make the valid exit's group cancellation happen first; a real
+				// writer failure must still dominate that success sentinel.
+				<-server.backgroundCtx.Done()
+				return failure
+			})
+			server = newProtocolExitServer(t, t.Context(), reader, writer)
+			if err := server.Run(t.Context()); err == nil || !errors.Is(err, failure) || !strings.Contains(err.Error(), "failed to write message") {
+				t.Fatalf("proper exit masked real concurrent writer failure: %v", err)
+			}
+		})
+	}
+}

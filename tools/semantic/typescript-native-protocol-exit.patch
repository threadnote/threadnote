+func TestServerProtocolExitWithImmediateEOF(t *testing.T) {
+	t.Parallel()
+	messages := []*lsproto.Message{protocolExitMessage(t, protocolShutdown), protocolExitMessage(t, protocolExit)}
+	index := 0
+	reader := protocolExitReaderFunc(func() (*lsproto.Message, error) {
+		if index == len(messages) {
+			return nil, io.EOF
+		}
+		msg := messages[index]
+		index++
+		return msg, nil
+	})
+	server := newProtocolExitServer(t, t.Context(), reader, shutdownTestWriter{})
+	if err := server.Run(t.Context()); err != nil {
+		t.Fatalf("proper exit followed immediately by input EOF failed: %v", err)
+	}
+}
+
+func TestServerProtocolExitWithoutInputEOF(t *testing.T) {
+	t.Parallel()
+	releaseInput := make(chan struct{})
+	readerReturned := make(chan struct{})
+	readerBlocked := make(chan struct{})
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(releaseInput) }) }
+	t.Cleanup(release)
+	messages := []*lsproto.Message{protocolExitMessage(t, protocolShutdown), protocolExitMessage(t, protocolExit)}
+	index := 0
+	reader := protocolExitReaderFunc(func() (*lsproto.Message, error) {
+		if index < len(messages) {
+			msg := messages[index]
+			index++
+			return msg, nil
+		}
+		close(readerBlocked)
+		<-releaseInput
+		close(readerReturned)
+		return nil, io.EOF
+	})
+	server := newProtocolExitServer(t, t.Context(), reader, shutdownTestWriter{})
+	if err := server.Run(t.Context()); err != nil {
+		t.Fatalf("proper exit required an input EOF: %v", err)
+	}
+	// Run intentionally cannot join a blocking Reader; release our actual read
+	// before test cleanup. Do not treat destroying a pipe as process completion.
+	release()
+	select {
+	case <-readerBlocked:
+		select {
+		case <-readerReturned:
+		case <-t.Context().Done():
+			t.Fatal("held reader did not return during cleanup")
+		}
+	default:
+		// Cancellation may win before the read loop starts its next read.
+		// releaseInput is already closed if that call starts later.
+	}
+}

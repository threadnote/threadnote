+type protocolExitReaderFunc func() (*lsproto.Message, error)
+
+func (f protocolExitReaderFunc) Read() (*lsproto.Message, error) { return f() }
+
+type protocolExitWriterFunc func(*lsproto.Message) error
+
+func (f protocolExitWriterFunc) Write(msg *lsproto.Message) error { return f(msg) }
+
+func protocolExitMessage(t *testing.T, body string) *lsproto.Message {
+	t.Helper()
+	reader := ToReader(strings.NewReader(fmt.Sprintf("Content-Length: %d\r\n\r\n%s", len(body), body)))
+	msg, err := reader.Read()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return msg
+}
+
+// Reuse the initialized real session fixture below. These examples exercise Run's
+// Reader/Writer lifecycle, not project initialization or an external executable.
+func newProtocolExitServer(t *testing.T, ctx context.Context, reader Reader, writer Writer) *Server {
+	t.Helper()
+	if !bundled.Embedded {
+		t.Skip("bundled files are not embedded")
+	}
+	fs := bundled.WrapFS(vfstest.FromMap(map[string]string{
+		"/test/tsconfig.json": "{}",
+		"/test/index.ts":      "const x = 1;",
+	}, tspath.CaseInsensitive))
+	server := NewServer(&ServerOptions{
+		In: reader, Out: writer, Err: io.Discard, Cwd: "/test",
+		FS: fs, DefaultLibraryPath: bundled.LibPath(),
+	})
+	server.initializeParams = &lsproto.InitializeParams{}
+	server.initStarted.Store(true)
+	server.session = project.NewSession(&project.SessionInit{
+		BackgroundCtx: ctx,
+		Options: &project.SessionOptions{
+			CurrentDirectory: "/test", DefaultLibraryPath: bundled.LibPath(),
+			PositionEncoding: lsproto.PositionEncodingKindUTF8,
+			WatchEnabled:     false, LoggingEnabled: false,
+		},
+		FS: fs, Logger: server.logger,
+	})
+	// Session.Close is idempotent for this fixture (no content-mapper host).
+	// Also close sessions when invalid input never reaches handleShutdown.
+	t.Cleanup(server.session.Close)
+	return server
+}

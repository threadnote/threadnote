+func TestServerProtocolExitRejectsInvalidTermination(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		messages []string
+	}{
+		{"exit-before-shutdown", []string{protocolExit}},
+		{"exit-request", []string{protocolShutdown, `{"jsonrpc":"2.0","id":"bad-exit","method":"exit"}`}},
+		{"invalid-exit-params", []string{protocolShutdown, `{"jsonrpc":"2.0","method":"exit","params":123}`}},
+		{"eof-without-exit", []string{protocolShutdown}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			messages := make([]*lsproto.Message, len(tc.messages))
+			for i, body := range tc.messages {
+				messages[i] = protocolExitMessage(t, body)
+			}
+			index := 0
+			reader := protocolExitReaderFunc(func() (*lsproto.Message, error) {
+				if index == len(messages) {
+					return nil, io.EOF
+				}
+				msg := messages[index]
+				index++
+				return msg, nil
+			})
+			server := newProtocolExitServer(t, t.Context(), reader, shutdownTestWriter{})
+			if err := server.Run(t.Context()); err == nil {
+				t.Fatal("invalid termination was accepted as a proper protocol exit")
+			}
+		})
+	}
+}

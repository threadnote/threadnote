+func TestServerProtocolExitPreservesQueuedLateReadFailure(t *testing.T) {
+	t.Parallel()
+	classified := make(chan struct{})
+	var once sync.Once
+	var server *Server
+	failure := &protocolExitLateReadFailure{
+		error: errors.New("late reader failure after queued exit"),
+		classifyEOF: func() {
+			once.Do(func() { close(classified) })
+			// The original read watcher has assigned readErr before this error
+			// classification. Let actual dispatch exit cancel the group first.
+			<-server.backgroundCtx.Done()
+		},
+	}
+	messages := []*lsproto.Message{protocolExitMessage(t, protocolShutdown), protocolExitMessage(t, protocolExit)}
+	index := 0
+	reader := protocolExitReaderFunc(func() (*lsproto.Message, error) {
+		if index < len(messages) {
+			msg := messages[index]
+			index++
+			return msg, nil
+		}
+		return nil, failure
+	})
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	server = newProtocolExitServer(t, ctx, reader, shutdownTestWriter{})
+	// Reuse the real FIFO's state seam. Holding the outgoing idle state blocks
+	// shutdown's response enqueue, but the reader can queue exit and its fault.
+	state := <-server.outgoingQueue.idle
+	var released sync.Once
+	release := func() { released.Do(func() { server.outgoingQueue.idle <- state }) }
+	defer release()
+	done := make(chan error, 1)
+	go func() { done <- server.Run(ctx) }()
+	select {
+	case <-classified:
+	case <-t.Context().Done():
+		t.Fatal("queued late read failure was not classified")
+	}
+	release()
+	select {
+	case err := <-done:
+		if err == nil || !errors.Is(err, failure) {
+			t.Fatalf("proper exit masked the original queued reader failure: %v", err)
+		}
+	case <-t.Context().Done():
+		t.Fatal("server did not finish after releasing the queue")
+	}
+}

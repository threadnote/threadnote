+func TestServerProtocolExitPreservesParentCancellation(t *testing.T) {
+	t.Parallel()
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	shutdown := protocolExitMessage(t, protocolShutdown)
+	exit := protocolExitMessage(t, protocolExit)
+	index := 0
+	reader := protocolExitReaderFunc(func() (*lsproto.Message, error) {
+		index++
+		if index == 1 {
+			return shutdown, nil
+		}
+		<-ctx.Done()
+		if index == 2 {
+			return exit, nil
+		}
+		return nil, io.EOF
+	})
+	writer := protocolExitWriterFunc(func(*lsproto.Message) error {
+		cancel()
+		return nil
+	})
+	server := newProtocolExitServer(t, ctx, reader, writer)
+	if err := server.Run(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("parent cancellation was treated as protocol success: %v", err)
+	}

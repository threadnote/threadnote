+type protocolExitLateReadFailure struct {
+	error
+	classifyEOF func()
+}
+
+func (e *protocolExitLateReadFailure) Is(target error) bool {
+	if target == io.EOF {
+		e.classifyEOF()
+	}
+	return false
+}

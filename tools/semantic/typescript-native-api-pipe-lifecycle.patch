+// errPipeParentEOF is internal lifecycle evidence from the original parent pipe.
+// Neither a protocol error nor arbitrary context cancellation is a clean close.
+var errPipeParentEOF = errors.New("original API parent stdin closed")
+
+func (s *StdioServer) runPipe(parent context.Context) error {
+	transport, err := ipc.NewPipeTransport(s.options.PipePath)
+	if err != nil {
+		return fmt.Errorf("failed to create pipe transport: %w", err)
+	}
+	ctx, cancel := context.WithCancelCause(parent)
+	defer cancel(context.Canceled)
+	closed := make(chan struct{})
+	stopClose := context.AfterFunc(ctx, func() {
+		_ = transport.Close()
+		close(closed)
+	})
+	defer func() {
+		if stopClose() {
+			_ = transport.Close()
+		} else {
+			<-closed
+		}
+	}()
+	finishInput := func() {}
+	if s.options.In != nil {
+		done := make(chan struct{})
+		var closingInput atomic.Bool
+		go func() {
+			defer close(done)
+			var byte [1]byte
+			n, readErr := s.options.In.Read(byte[:])
+			if n != 0 {
+				cancel(errors.New("unexpected data on API parent lifecycle stream"))
+			} else if errors.Is(readErr, io.EOF) {
+				cancel(errPipeParentEOF)
+			} else if readErr != nil {
+				if !closingInput.Load() || (!errors.Is(readErr, os.ErrClosed) && !errors.Is(readErr, io.ErrClosedPipe)) {
+					cancel(fmt.Errorf("API parent lifecycle read failed: %w", readErr))
+				}
+			} else {
+				cancel(errors.New("API parent lifecycle read made no progress"))
+			}
+		}()
+		finishInput = func() {
+			closingInput.Store(true)
+			_ = s.options.In.Close()
+			<-done
+		}
+		defer finishInput()
+	}
+	err = s.runTransport(ctx, transport)
+	// Join the lifecycle reader before deciding success. Teardown-induced closed
+	// reads are ignored; bytes, EOF and actual read failures are never discarded.
+	finishInput()
+	cause := context.Cause(ctx)
+	if parent.Err() != nil {
+		return errors.Join(parent.Err(), err)
+	}
+	if errors.Is(cause, errPipeParentEOF) {
+		if pipeLifecycleCloseError(err) {
+			return nil
+		}
+		return err
+	}
+	if cause != nil {
+		return errors.Join(cause, err)
+	}
+	return err
+}
+
+// A joined real request/reader fault must survive concurrent lifecycle closure.
+func pipeLifecycleCloseError(err error) bool {
+	if err == nil {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		for _, nested := range joined.Unwrap() {
+			if !pipeLifecycleCloseError(nested) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return pipeLifecycleCloseError(wrapped.Unwrap())
+	}
+	return err == net.ErrClosed || err == io.ErrClosedPipe || err == context.Canceled
+}

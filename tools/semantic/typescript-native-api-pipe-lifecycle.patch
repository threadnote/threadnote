+	defer transport.Close()
+	path := transport.Path()
+	before, err := os.Lstat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	accepted := make(chan net.Conn, 1)
+	failed := make(chan error, 1)
+	go func() {
+		connection, err := transport.Accept()
+		if err != nil {
+			failed <- err
+			return
+		}
+		accepted <- connection.(net.Conn)

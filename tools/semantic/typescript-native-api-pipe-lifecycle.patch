+func TestServerAPIOneShotNamespaceSurvivesAcceptedSession(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("Windows public connector/namespace proof belongs to actual Windows qualification")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server := newProtocolExitServer(t, ctx, shutdownTestReader{}, shutdownTestWriter{})
+	server.backgroundCtx = ctx
+	defer server.closeAPISessions()
+	issued, err := server.handleInitializeAPISession(ctx, &lsproto.InitializeAPISessionParams{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server.apiSessionsMu.Lock()
+	state := server.apiSessions[issued.SessionId]
+	server.apiSessionsMu.Unlock()
+	if state == nil {
+		t.Fatal("original API session not retained")
+	}
+	before, err := os.Lstat(issued.Pipe)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, err := net.DialTimeout("unix", issued.Pipe, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	_ = client.SetDeadline(time.Now().Add(5 * time.Second))
+	protocol := ipc.NewJSONRPCProtocol(client)
+	if err := protocol.WriteRequest(jsonrpc.NewIDInt(1), "initialize", nil); err != nil {
+		t.Fatal(err)
+	}
+	response, err := protocol.ReadMessage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !response.IsResponse() || response.Error != nil {
+		t.Fatalf("actual API initialization failed: %v", response.Error)
+	}
+	// A real response is an ordering barrier after the one original accept and
+	// listener stop, not a sleep or a fake observed connection.
+	after, err := os.Lstat(issued.Pipe)
+	if err != nil || !os.SameFile(before, after) {
+		t.Fatalf("active API lost its original namespace: %v", err)
+	}
+	if second, err := net.DialTimeout("unix", issued.Pipe, time.Second); err == nil {
+		second.Close()
+		t.Fatal("one-shot API listener admitted another connection")
+	}
+	if err := client.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-state.done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("original API connection/session cleanup did not join")
+	}
+	if _, err := os.Lstat(issued.Pipe); !os.IsNotExist(err) {
+		t.Fatalf("finished API socket remains: %v", err)
+	}
+	if _, err := os.Lstat(filepath.Dir(issued.Pipe)); !os.IsNotExist(err) {
+		t.Fatalf("finished API directory remains: %v", err)
+	}
+}
